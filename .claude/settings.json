{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/tools/adr/src/cli/agent-guard.ts\""
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": ["Bash(pnpm adr:decide *)", "Bash(pnpm run adr:decide *)"]
  }
}
