+#pragma mark - Claiming the bars again (patched by humanite-app)
+
+/**
+ * The nearest scroll view this marker is laid in, if any: a pager whose pages each hold a marked list.
+ *
+ * Upstream registers a marker once, as it reaches the window, and the last to register owns the bars. In a pager
+ * every page it has built reaches the window at once, so the bars follow whichever page came last, not the one on the
+ * screen: on the iPhone simulator on 25/09/2026, the front page's tab bar followed the list of the section beside it,
+ * off the screen, and never shrank under the one being read. A marker laid in another scroll view therefore registers
+ * only when its page is on the screen — as it reaches the window, and whenever the scroll view it is laid in comes to
+ * rest — and any marker registers again when the reader starts dragging its list, which is the one they are reading.
+ */
+- (nullable RCTScrollViewComponentView *)findEnclosingScrollView
+{
+  UIView *ancestor = self.superview;
+  while (ancestor != nil) {
+    if ([ancestor isKindOfClass:RCTScrollViewComponentView.class]) {
+      return static_cast<RCTScrollViewComponentView *>(ancestor);
+    }
+    ancestor = ancestor.superview;
+  }
+  return nil;
+}
+
+/** Whether most of this marker's width is on the screen: the page of a pager at rest, and none of its neighbours. */
+- (BOOL)isOnScreen
+{
+  UIWindow *window = self.window;
+  if (window == nil) {
+    return NO;
+  }
+  const CGRect frame = [self convertRect:self.bounds toView:nil];
+  const CGRect shown = CGRectIntersection(frame, window.bounds);
+  return !CGRectIsNull(shown) && CGRectGetWidth(shown) * 2 > CGRectGetWidth(frame);
+}
+
+- (void)registerIfOnScreen
+{
+  if ([self isOnScreen]) {
+    [self registerWithSeekingAncestor];
+  }
+}
+
+- (void)startListening
+{
+  [self stopListening];
+  UIView *child = self.subviews.firstObject;
+  if ([child isKindOfClass:RCTScrollViewComponentView.class]) {
+    _ownScrollView = static_cast<RCTScrollViewComponentView *>(child);
+    [_ownScrollView addScrollListener:self];
+  }
+  _enclosingScrollView = [self findEnclosingScrollView];
+  [_enclosingScrollView addScrollListener:self];
+}
+
+- (void)stopListening
+{
+  [_ownScrollView removeScrollListener:self];
+  [_enclosingScrollView removeScrollListener:self];
+  _ownScrollView = nil;
+  _enclosingScrollView = nil;
