{
  "name": "@huma/workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.26.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.17.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "adr:check": "node tools/adr/src/cli/check.ts",
    "adr:decide": "node tools/adr/src/cli/decide.ts",
    "adr:index": "node tools/adr/src/cli/write-index.ts",
    "adr:new": "node tools/adr/src/cli/new.ts",
    "adr:status": "node tools/adr/src/cli/status.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint --flag unstable_native_nodejs_ts_config --max-warnings 0 .",
    "typecheck": "tsc --build",
    "test": "vitest run",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm adr:check"
  },
  "devDependencies": {
    "@huma/eslint-config": "workspace:*",
    "@huma/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
