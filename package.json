{
  "name": "@huma/workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.27.1",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.21.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "adr:check": "node tools/governance/src/cli/adr-check.ts",
    "adr:decide": "node tools/governance/src/cli/adr-decide.ts",
    "adr:new": "node tools/governance/src/cli/adr-new.ts",
    "adr:status": "node tools/governance/src/cli/adr-status.ts",
    "capture:read": "node tools/governance/src/cli/capture-read.ts",
    "corpus:generate": "node tools/governance/src/cli/corpus-generate.ts",
    "deps:check": "node tools/governance/src/cli/deps-check.ts",
    "emulator:build": "node tools/governance/src/cli/emulator-build.ts",
    "emulator:down": "node tools/governance/src/cli/emulator-down.ts",
    "emulator:e2e": "node tools/governance/src/cli/emulator-e2e.ts",
    "emulator:gradle": "node tools/governance/src/cli/emulator-gradle.ts",
    "emulator:install": "node tools/governance/src/cli/emulator-install.ts",
    "emulator:metro": "node tools/governance/src/cli/emulator-metro.ts",
    "emulator:status": "node tools/governance/src/cli/emulator-status.ts",
    "emulator:up": "node tools/governance/src/cli/emulator-up.ts",
    "expo:types": "node tools/governance/src/cli/expo-types.ts",
    "format": "node tools/governance/src/cli/format.ts",
    "format:check": "node tools/governance/src/cli/format.ts --check",
    "gen": "node tools/governance/src/cli/gen.ts",
    "gen:check": "node tools/governance/src/cli/gen.ts --check",
    "hooks:check": "node tools/governance/src/cli/hooks-check.ts",
    "hooks:install": "node tools/governance/src/cli/hooks-install.ts",
    "knip": "knip --no-progress --no-config-hints",
    "lint": "node tools/governance/src/cli/lint.ts",
    "perf:check": "node tools/governance/src/cli/perf-check.ts",
    "structure:check": "node tools/governance/src/cli/structure-check.ts",
    "test": "vitest run",
    "test:app": "node tools/governance/src/cli/test-app.ts",
    "typecheck": "tsc --build",
    "verify": "node tools/governance/src/cli/verify.ts"
  },
  "devDependencies": {
    "@huma/eslint-config": "workspace:*",
    "@huma/tsconfig": "workspace:*",
    "@huma/unknown": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "knip": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
