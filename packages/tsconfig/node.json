{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./base.json",
  "compilerOptions": {
    "target": "es2024",
    "lib": ["ES2025", "ESNext.Array", "ESNext.Disposable", "ESNext.Error", "ESNext.SharedMemory"],
    "types": ["node"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true
  }
}
